              "raw": "{{baseUrlHistorico}}/graphql",
              "host": ["{{baseUrlHistorico}}"],
              "path": ["graphql"]
            },
            "description": "Retorna o ciclo de vida COMPLETO de uma consulta específica (todos os eventos em ordem cronológica). Exclusivo para ADMIN."
          }
        }
      ]
    }
  ]
}
