        {
          "name": "Cadastrar médico",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Dr. Carlos Eduardo Ferreira\",\n  \"email\": \"carlos.ferreira@hospital.com\",\n  \"ddd\": \"11\",\n  \"telefone\": \"991234567\",\n  \"sexo\": \"MASCULINO\",\n  \"dataNascimento\": \"1980-03-10\",\n  \"endereco\": {\n    \"logradouro\": \"Rua das Flores\",\n    \"numero\": \"123\",\n    \"complemento\": \"Sala 5\",\n    \"bairro\": \"Centro\",\n    \"cidade\": \"São Paulo\",\n    \"uf\": \"SP\",\n    \"cep\": \"01310100\"\n  },\n  \"login\": \"carlosmed\",\n  \"senha\": \"Senha@123\",\n  \"crm\": \"123456\",\n  \"crmUf\": \"SP\",\n  \"especialidade\": \"CARDIOLOGIA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/medicos",
              "host": ["{{baseUrl}}"],
              "path": ["medicos"]
            },
            "description": "Cadastra um novo médico. Requer role ADMIN.\n\nEspecialidades válidas: CARDIOLOGIA, DERMATOLOGIA, ENDOCRINOLOGIA, GASTROENTEROLOGIA, GERIATRIA, GINECOLOGIA, HEMATOLOGIA, INFECTOLOGIA, NEFROLOGIA, NEUROLOGIA, OFTALMOLOGIA, ONCOLOGIA, ORTOPEDIA, OTORRINOLARINGOLOGIA, PEDIATRIA, PNEUMOLOGIA, PSIQUIATRIA, REUMATOLOGIA, UROLOGIA, CIRURGIA_GERAL, CLINICO_GERAL\n\nSexo: MASCULINO | FEMININO | OUTRO"
          }
        },
        {
          "name": "Buscar médico por CRM",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/medicos/crm/123456",
              "host": ["{{baseUrl}}"],
              "path": ["medicos", "crm", "123456"]
            },
            "description": "Busca um médico pelo número do CRM. Requer role MEDICO, ENFERMEIRO ou ADMIN."
          }
        },
        {
          "name": "Buscar médicos por nome",
