            "url": {
              "raw": "{{baseUrl}}/medicos/nome?nome=Carlos&page=0&size=10&sort=nome",
              "host": ["{{baseUrl}}"],
              "path": ["medicos", "nome"],
              "query": [
                { "key": "nome", "value": "Carlos" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "nome" }
