"""
Registro histórico de uma consulta médica armazenado pelo serviço de histórico.
Cada evento de ciclo de vida de uma consulta (agendamento, atualização, realização, cancelamento)
gera um novo registro independente nesta coleção.
"""
type HistoricoConsulta {
    "Identificador único do registro no banco de dados."
    id: ID

    "Identificador da consulta no serviço ms-gestao-consultas."
    consultaId: ID

    "Nome completo do paciente no momento do evento."
    pacienteNome: String

    "CPF do paciente (somente dígitos, sem máscara)."
    pacienteCpf: String

    "E-mail do paciente para contato."
    pacienteEmail: String

    "Nome completo do médico responsável pela consulta."
    medicoNome: String

    "CRM do médico responsável pela consulta."
    medicoCrm: String

    "Especialidade médica associada à consulta."
    especialidade: String

    "Data e hora agendada para a consulta (formato: yyyy-MM-dd'T'HH:mm:ss)."
    dataHora: String

    "Status da consulta no momento do evento: AGENDADA | ATUALIZADA | REALIZADA | CANCELADA."
    status: String

    "Tipo do evento que originou o registro: AGENDAMENTO | ATUALIZACAO | REALIZACAO | CANCELAMENTO | ATUALIZACAO_ATENDIMENTO."
    tipoEvento: String

    "Data e hora em que o evento foi gerado pelo ms-gestao-consultas (formato: yyyy-MM-dd'T'HH:mm:ss)."
    dataEvento: String

    "Data e hora em que o registro foi persistido neste serviço (formato: yyyy-MM-dd'T'HH:mm:ss)."
    dataDoRegistro: String

    "Diagnóstico médico registrado no atendimento."
    diagnostico: String

    "Tratamento proposto pelo médico."
    tratamentoProposto: String

    "Demais observações clínicas."
    demaisObservacoes: String
}

"""
Visão resumida do histórico de consultas para o paciente autenticado.
Não expõe dados clínicos como diagnóstico, tratamento e observações.
"""
type HistoricoConsultaResumo {
    id: ID
    consultaId: ID
    pacienteNome: String
    pacienteCpf: String
    pacienteEmail: String
    medicoNome: String
    medicoCrm: String
    especialidade: String
    dataHora: String
    status: String
    tipoEvento: String
    dataEvento: String
    dataDoRegistro: String
}

type Query {

    """
    Retorna o ÚLTIMO ESTADO de cada consulta do paciente informado (um registro por consultaId).
    Ideal para médicos e enfermeiros visualizarem a situação atual das consultas.
    O CPF pode ser enviado com ou sem máscara (ex: 123.456.789-00 ou 12345678900).
    """
    buscarPorPacienteCpf(
        "CPF do paciente, com ou sem máscara. Obrigatório."
        cpf: String!
        "Número da página (base 0). Padrão: 0."
        page: Int
        "Quantidade de registros por página. Padrão: 10."
        size: Int
    ): [HistoricoConsulta]

    """
    Retorna o ÚLTIMO ESTADO de cada consulta do paciente, filtrando apenas
    as consultas com dataHora posterior à data informada.
    Ideal para listar consultas futuras ou recentes de um paciente.
    """
    buscarPorPacienteCpfAposData(
        "CPF do paciente, com ou sem máscara. Obrigatório."
        cpf: String!
        "Data/hora de corte no formato yyyy-MM-dd'T'HH:mm:ss (ex: 2025-01-01T00:00:00). Obrigatório."
        dataHora: String!
        "Número da página (base 0). Padrão: 0."
        page: Int
        "Quantidade de registros por página. Padrão: 10."
        size: Int
    ): [HistoricoConsulta]

    """
    Retorna o ÚLTIMO ESTADO de cada consulta filtrando por nome parcial do paciente (case-insensitive).
    """
    buscarPorPacienteNome(
        "Trecho do nome do paciente (mínimo recomendado: 3 caracteres). Obrigatório."
        nome: String!
        "Número da página (base 0). Padrão: 0."
        page: Int
        "Quantidade de registros por página. Padrão: 10."
        size: Int
    ): [HistoricoConsulta]

    """
    Retorna o ÚLTIMO ESTADO de cada consulta do médico informado pelo CRM.
    """
    buscarPorMedicoCrm(
        "CRM do médico. Obrigatório."
        crm: String!
        "Número da página (base 0). Padrão: 0."
        page: Int
        "Quantidade de registros por página. Padrão: 10."
        size: Int
    ): [HistoricoConsulta]

    """
    Retorna o ÚLTIMO ESTADO de cada consulta filtrando por nome parcial do médico (case-insensitive).
    """
    buscarPorMedicoNome(
        "Trecho do nome do médico (mínimo recomendado: 3 caracteres). Obrigatório."
        nome: String!
        "Número da página (base 0). Padrão: 0."
        page: Int
        "Quantidade de registros por página. Padrão: 10."
        size: Int
    ): [HistoricoConsulta]

    """
    Retorna o ÚLTIMO ESTADO de cada consulta filtrando pelo status atual.
    Valores aceitos: AGENDADA, ATUALIZADA, REALIZADA, CANCELADA.
    Retorna erro BAD_REQUEST para status inválido.
    """
    buscarPorStatus(
        "Status da consulta. Valores aceitos: AGENDADA | ATUALIZADA | REALIZADA | CANCELADA. Obrigatório."
        status: String!
        "Número da página (base 0). Padrão: 0."
        page: Int
        "Quantidade de registros por página. Padrão: 10."
        size: Int
    ): [HistoricoConsulta]

    """
    Retorna o ÚLTIMO ESTADO de cada consulta cujo dataEvento esteja dentro do período informado.
    Útil para médicos e enfermeiros consultarem consultas recentes em um intervalo de datas.
    Disponível para MEDICO, ENFERMEIRO e ADMIN.
    """
    buscarPorPeriodo(
        "Data/hora de início no formato yyyy-MM-dd'T'HH:mm:ss. Obrigatório."
        inicio: String!
        "Data/hora de fim no formato yyyy-MM-dd'T'HH:mm:ss. Obrigatório."
        fim: String!
        "Número da página (base 0). Padrão: 0."
        page: Int
        "Quantidade de registros por página. Padrão: 10."
        size: Int
    ): [HistoricoConsulta]

    """
    Retorna o ÚLTIMO ESTADO das consultas do paciente autenticado.
    Não requer nenhum argumento — o CPF é extraído automaticamente do token JWT.
    Não expõe dados clínicos (diagnóstico, tratamento, observações).
    Exclusivo para usuários com papel PACIENTE.
    """
    minhasConsultas(
        "Número da página (base 0). Padrão: 0."
        page: Int
        "Quantidade de registros por página. Padrão: 10."
        size: Int
    ): [HistoricoConsultaResumo]


    """
    [AUDITORIA] Retorna o ciclo de vida COMPLETO de todas as consultas de um paciente,
    incluindo todos os eventos: agendamento, atualizações, realização e cancelamento.
    Exclusivo para ADMIN.
    """
    auditoriaBuscarPorCpf(
        "CPF do paciente, com ou sem máscara. Obrigatório."
        cpf: String!
        "Número da página (base 0). Padrão: 0."
        page: Int
        "Quantidade de registros por página. Padrão: 10."
        size: Int
    ): [HistoricoConsulta]

    """
    [AUDITORIA] Retorna todos os eventos registrados no período informado,
    ordenados por consultaId e dataEvento. Útil para análise temporal de atividades.
    Exclusivo para ADMIN.
    """
    auditoriaBuscarPorPeriodo(
        "Data/hora de início no formato yyyy-MM-dd'T'HH:mm:ss. Obrigatório."
        inicio: String!
        "Data/hora de fim no formato yyyy-MM-dd'T'HH:mm:ss. Obrigatório."
        fim: String!
        "Número da página (base 0). Padrão: 0."
        page: Int
        "Quantidade de registros por página. Padrão: 10."
        size: Int
    ): [HistoricoConsulta]

    """
    [AUDITORIA] Retorna o ciclo de vida COMPLETO de uma consulta específica,
    mostrando todos os eventos em ordem cronológica.
    Exclusivo para ADMIN.
    """
    auditoriaBuscarPorConsultaId(
        "ID da consulta no ms-gestao-consultas. Obrigatório."
        consultaId: ID!
        "Número da página (base 0). Padrão: 0."
        page: Int
        "Quantidade de registros por página. Padrão: 10."
        size: Int
    ): [HistoricoConsulta]
}